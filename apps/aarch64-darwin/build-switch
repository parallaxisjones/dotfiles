#!/bin/sh
set -eu

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

SYSTEM_TYPE="aarch64-darwin"
FLAKE_SYSTEM="darwinConfigurations.${SYSTEM_TYPE}.system"

export NIXPKGS_ALLOW_UNFREE=1

# Pull the latest merged config from origin first, so a single `build-switch`
# always applies the up-to-date flake.lock without a manual `git pull`.
# --autostash shelves any local edits, rebases, then restores them.
printf '%b\n' "${YELLOW}Syncing with origin...${NC}"
git pull --rebase --autostash

printf '%b\n' "${YELLOW}Starting build...${NC}"
nix --extra-experimental-features 'nix-command flakes' build ".#$FLAKE_SYSTEM" "$@"

printf '%b\n' "${YELLOW}Switching to new generation...${NC}"
# See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
sudo ./result/sw/bin/darwin-rebuild switch --flake ".#${SYSTEM_TYPE}" "$@"

printf '%b\n' "${YELLOW}Cleaning up...${NC}"
unlink ./result

printf '%b\n' "${GREEN}Switch to new generation complete!${NC}"
